{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/job.schema.json",
  "title": "sfo exchange: job.json",
  "description": "Head of an export: the format version and the job the line files belong to. Written last; when it is there, the line files are complete.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "job_id",
    "root_path",
    "parts"
  ],
  "properties": {
    "format": {
      "const": "sfo-exchange"
    },
    "format_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Major.minor. A reader of major 1 reads every 1.x and ignores keys it does not know."
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "disclosure": {
      "enum": [
        "open",
        "restricted"
      ],
      "description": "The setting Sensitive:Disclosure of the export."
    },
    "include_sensitive": {
      "type": "boolean"
    },
    "job_id": {
      "type": "integer"
    },
    "root_path": {
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/ScanRole"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "structure_only": {
      "type": "boolean"
    },
    "rules_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "directories": {
      "type": "integer",
      "minimum": 0,
      "description": "Lines in directories.jsonl."
    },
    "files": {
      "type": "integer",
      "minimum": 0,
      "description": "Lines in files.jsonl."
    },
    "findings": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Lines of findings.jsonl; null when it was not written (a library job). Since 1.1."
    },
    "plan_actions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Lines of plan.jsonl; null when it was not written (a library job). Since 1.1."
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Plan"
      },
      "description": "The plans of the job, oldest first; their actions are the lines of plan.jsonl. Since 1.1."
    },
    "parts": {
      "type": "array",
      "items": {
        "enum": [
          "directories.jsonl",
          "files.jsonl",
          "findings.jsonl",
          "plan.jsonl"
        ]
      },
      "description": "The line files next to job.json, in reading order. findings.jsonl and plan.jsonl (since 1.1) are written for a source, empty when it has none."
    }
  },
  "$defs": {
    "ScanRole": {
      "oneOf": [
        {
          "const": "source",
          "description": "A medium to be cleaned up (the default)."
        },
        {
          "const": "library",
          "description": "The organised archive of the person: only read, never changed, never analysed by a model."
        }
      ]
    },
    "JobStatus": {
      "enum": [
        "created",
        "running",
        "paused",
        "completed",
        "cancelled",
        "failed"
      ],
      "description": "Codes of JobStatus, see docs/glossary.md."
    },
    "Plan": {
      "type": "object",
      "required": [
        "id",
        "created_at",
        "library_job_ids",
        "notes",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "library_job_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "The library jobs whose roots its targets may lie in."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What the creation left out and why."
        },
        "actions": {
          "type": "integer",
          "minimum": 0,
          "description": "Its lines in plan.jsonl."
        }
      }
    }
  }
}
