{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crack666/smart_file_organizer/schemas/cli/v1/summary.result.schema.json",
  "title": "sfo summary --json: result",
  "description": "The 'result' of 'sfo summary --json' (envelope schema_version 1). Generated from the result records; code fields refer to the exchange schemas. docs/cli.md describes every field.",
  "type": "object",
  "properties": {
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "root_path": {
          "type": "string"
        },
        "role": {
          "enum": [
            "source",
            "library"
          ]
        },
        "status": {
          "enum": [
            "created",
            "running",
            "paused",
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "files_total": {
          "type": "integer"
        },
        "files_processed": {
          "type": "integer"
        },
        "directories_total": {
          "type": "integer"
        },
        "directories_processed": {
          "type": "integer"
        },
        "error_count": {
          "type": "integer"
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "hash": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "source",
            "hash"
          ],
          "additionalProperties": false
        },
        "structure_only": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "root_path",
        "role",
        "status",
        "created_at",
        "started_at",
        "completed_at",
        "files_total",
        "files_processed",
        "directories_total",
        "directories_processed",
        "error_count",
        "last_error",
        "rules",
        "structure_only"
      ],
      "additionalProperties": false
    },
    "directories": {
      "type": "integer"
    },
    "sensitive_directories": {
      "type": "integer"
    },
    "files": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "sensitive": {
          "type": "integer"
        },
        "total_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "total",
        "pending",
        "errors",
        "sensitive",
        "total_bytes"
      ],
      "additionalProperties": false
    },
    "by_category": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/file.schema.json#/$defs/FileCategory"
          },
          {
            "enum": [
              "unclassified"
            ]
          }
        ]
      }
    },
    "by_file_type": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/file.schema.json#/$defs/FileType"
      }
    },
    "by_status": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/file.schema.json#/$defs/FileNodeStatus"
      }
    },
    "by_sensitive_marker": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/file.schema.json#/$defs/SensitiveMarker"
      }
    },
    "directories_by_verdict": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/directory.schema.json#/$defs/DirectoryVerdictKind"
          },
          {
            "enum": [
              "none",
              "error"
            ]
          }
        ]
      }
    },
    "directories_by_retention": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/directory.schema.json#/$defs/RetentionValue"
          },
          {
            "enum": [
              "none"
            ]
          }
        ]
      }
    },
    "largest_directories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relative_path": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "files": {
            "type": "integer"
          },
          "verdict": {
            "oneOf": [
              {
                "anyOf": [
                  {
                    "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/directory.schema.json#/$defs/DirectoryVerdictKind"
                  },
                  {
                    "enum": [
                      "none",
                      "error"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "retention": {
            "oneOf": [
              {
                "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/directory.schema.json#/$defs/RetentionValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "sensitive_files": {
            "type": "integer"
          }
        },
        "required": [
          "relative_path",
          "size_bytes",
          "files",
          "verdict",
          "retention",
          "sensitive_files"
        ],
        "additionalProperties": false
      }
    },
    "bundles": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "built_at": {
          "type": "string",
          "format": "date-time"
        },
        "dump_count": {
          "type": "integer"
        },
        "bundle_count": {
          "type": "integer"
        },
        "unbundled_files": {
          "type": "integer"
        },
        "dumps": {
          "type": "object",
          "properties": {
            "directories": {
              "type": "integer"
            },
            "empty_directories": {
              "type": "integer"
            },
            "files": {
              "type": "integer"
            },
            "total_bytes": {
              "type": "integer"
            },
            "by_file_type": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          },
          "required": [
            "directories",
            "empty_directories",
            "files",
            "total_bytes",
            "by_file_type"
          ],
          "additionalProperties": false
        },
        "without_dumps": {
          "type": "object",
          "properties": {
            "directories": {
              "type": "integer"
            },
            "empty_directories": {
              "type": "integer"
            },
            "files": {
              "type": "integer"
            },
            "total_bytes": {
              "type": "integer"
            },
            "by_file_type": {
              "$ref": "#/properties/bundles/properties/dumps/properties/by_file_type"
            }
          },
          "required": [
            "directories",
            "empty_directories",
            "files",
            "total_bytes",
            "by_file_type"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "built_at",
        "dump_count",
        "bundle_count",
        "unbundled_files",
        "dumps",
        "without_dumps"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "listed": {
          "type": "integer"
        },
        "sure": {
          "type": "integer"
        },
        "unsure": {
          "type": "integer"
        },
        "by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/finding.schema.json#/$defs/FindingKind"
          }
        },
        "by_certainty": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/finding.schema.json#/$defs/ResultCertainty"
          }
        },
        "by_state": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "https://github.com/crack666/smart_file_organizer/schemas/exchange/v1/finding.schema.json#/$defs/FindingState"
          }
        },
        "missing_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "listed",
        "sure",
        "unsure",
        "by_kind",
        "by_certainty",
        "by_state",
        "missing_steps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "job",
    "directories",
    "sensitive_directories",
    "files",
    "by_category",
    "by_file_type",
    "by_status",
    "by_sensitive_marker",
    "directories_by_verdict",
    "directories_by_retention",
    "largest_directories",
    "bundles",
    "findings"
  ],
  "additionalProperties": false
}
