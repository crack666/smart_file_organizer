# Standard-.gitattributes fuer eigene Repos auf dieser Maschine.
# Kopieren als .gitattributes in die Repo-Wurzel, dann einmal:
#   git add --renormalize . && git commit -m "chore: add .gitattributes"
#
# Warum: ohne diese Datei speichert Git auf Windows die Zeilenenden so, wie sie
# im Arbeitsverzeichnis liegen. Jeder Checkout kann sie flippen, und das Repo
# sieht nach massiver Drift aus, obwohl sich inhaltlich nichts geaendert hat.
# Gemessen am 31.08.2026: Zeitmeister_Frontend 19.820 geaenderte Zeilen,
# davon 0 mit echtem Inhalt. Dickerchen 9.326 -> 0. AVR2025 6.121 -> 0.
# Das Rauschen schreckt vom Committen ab und versteckt die echte Arbeit.

# Im Repo immer LF, im Arbeitsverzeichnis plattformnativ.
* text=auto

# Skripte, die zwingend CRLF brauchen
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Shell-Skripte immer LF - auch auf Windows, sonst scheitern sie in WSL/Containern
*.sh   text eol=lf

# Binaerdateien nie anfassen
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.age binary
