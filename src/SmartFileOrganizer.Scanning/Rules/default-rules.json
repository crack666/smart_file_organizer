{
  "schema_version": 1,
  "name": "default",
  "description": "Shipped rules: leave out build output, package caches and operating system folders; always scan the usual user folders. Copy this file to make a profile for one drive.",
  "shallow_from": 6,
  "safety_limit": 32,
  "skip_hidden": true,
  "user_types": ["image", "video", "audio", "document"],
  "program_types": ["executable"],
  "rules": [
    { "match": "node_modules", "action": "skip", "why": "JavaScript packages, restored by npm" },
    { "match": ".git", "action": "skip", "why": "version control data" },
    { "match": ".svn", "action": "skip", "why": "version control data" },
    { "match": ".hg", "action": "skip", "why": "version control data" },
    { "match": "bin", "action": "skip", "why": "build output" },
    { "match": "obj", "action": "skip", "why": "build output" },
    { "match": "__pycache__", "action": "skip", "why": "Python byte code cache" },
    { "match": ".mypy_cache", "action": "skip", "why": "type checker cache" },
    { "match": "Windows", "action": "skip", "why": "operating system" },
    { "match": "System32", "action": "skip", "why": "operating system" },
    { "match": "SysWOW64", "action": "skip", "why": "operating system" },
    { "match": "$Recycle.Bin", "action": "skip", "why": "recycle bin" },
    { "match": "System Volume Information", "action": "skip", "why": "file system metadata" },
    { "match": "AppData", "action": "skip", "why": "application settings and caches" },
    { "match": "ProgramData/Microsoft", "action": "skip", "why": "operating system data" },
    { "match": "ProgramData/Package Cache", "action": "skip", "why": "installer cache" },
    { "match": "Program Files", "action": "skip", "why": "installed programs" },
    { "match": "Program Files (x86)", "action": "skip", "why": "installed programs" },
    { "match": ".nuget", "action": "skip", "why": "NuGet package cache" },
    { "match": "packages", "action": "skip", "why": "package cache" },

    { "match": "Documents", "action": "user_data" },
    { "match": "Pictures", "action": "user_data" },
    { "match": "Videos", "action": "user_data" },
    { "match": "Music", "action": "user_data" },
    { "match": "Desktop", "action": "user_data" },
    { "match": "Downloads", "action": "user_data" },
    { "match": "Photos", "action": "user_data" },
    { "match": "Fotos", "action": "user_data" },
    { "match": "Bilder", "action": "user_data" },
    { "match": "Dokumente", "action": "user_data" },
    { "match": "Eigene Dateien", "action": "user_data" },
    { "match": "OneDrive", "action": "user_data" },
    { "match": "Dropbox", "action": "user_data" },
    { "match": "Google Drive", "action": "user_data" }
  ]
}
