<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command line front end "sfo". Uses the same core as the GUI through the Hosting project;
       no Avalonia. Contract for machine callers: docs/cli.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sfo</AssemblyName>
    <RootNamespace>SmartFileOrganizer.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartFileOrganizer.Hosting\SmartFileOrganizer.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argument parsing, help and validation. MIT, maintained by the .NET team. -->
    <PackageReference Include="System.CommandLine" Version="2.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartFileOrganizer.Cli.Tests" />
  </ItemGroup>

</Project>
