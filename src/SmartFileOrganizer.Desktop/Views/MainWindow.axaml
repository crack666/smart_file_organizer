<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartFileOrganizer.Desktop.ViewModels"
        xmlns:views="using:SmartFileOrganizer.Desktop.Views"
        x:Class="SmartFileOrganizer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Smart File Organizer"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#1E1E1E">

    <DockPanel Background="#1E1E1E">

        <!-- ===== Toolbar ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="📁 Choose Folder"
                        Command="{Binding PickFolderCommand}"
                        Margin="0,0,4,0" />

                <TextBlock Text="{Binding RootPath}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           MaxWidth="400"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                <Button Content="▶ Start Scan"
                        Command="{Binding StartScanCommand}"
                        Margin="0,0,4,0" />

                <Button Content="⏸ Pause"
                        Command="{Binding PauseScanCommand}"
                        IsEnabled="{Binding IsScanRunning}"
                        Margin="0,0,4,0" />

                <Button Content="⏹ Cancel"
                        Command="{Binding CancelScanCommand}"
                        IsEnabled="{Binding IsScanRunning}"
                        Margin="0,0,12,0" />

                <!-- Progress -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScanProgress.StatusText}"
                               FontSize="11"
                               Margin="0,0,0,2"/>
                    <ProgressBar Value="{Binding ScanProgress.ProgressPercent}"
                                 Minimum="0" Maximum="100"
                                 Width="200" Height="6" />
                </StackPanel>

                <Separator Margin="12,0" Width="1" Height="28" />

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AiProgress.StatusText}"
                           FontSize="11"
                           Margin="0,0,0,2"/>
                    <ProgressBar Value="{Binding AiProgress.ProgressPercent}"
                         Minimum="0" Maximum="100"
                         Width="220" Height="6" />
                </StackPanel>

                <Button Content="▶ Resume AI"
                    Command="{Binding ResumeAiCommand}"
                    Margin="12,0,4,0" />

                <Button Content="⏸ Pause AI"
                    Command="{Binding PauseAiCommand}"
                    Margin="0,0,4,0" />

                <Button Content="⏹ Stop AI"
                    Command="{Binding CancelAiCommand}" />

                <Separator Margin="12,0" Width="1" Height="28" />

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Ollama URL" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding OllamaBaseUrl, Mode=TwoWay}"
                             Width="180"
                             Watermark="http://localhost:11434" />
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Vision model" FontSize="11" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding AvailableOllamaModels}"
                              SelectedItem="{Binding SelectedOllamaModel, Mode=TwoWay}"
                              Width="260">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OllamaModelViewModel">
                                <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Keep alive" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding OllamaKeepAlive, Mode=TwoWay}"
                             Width="90"
                             Watermark="60m" />
                </StackPanel>

                <Button Content="🔄 Models"
                        Command="{Binding RefreshOllamaModelsCommand}"
                        Margin="0,18,4,0" />

                <Button Content="💾 Save AI"
                        Command="{Binding SaveOllamaSettingsCommand}"
                        Margin="0,18,4,0" />

                <Button Content="📝 Prompt…"
                        Command="{Binding OpenPromptSettingsCommand}"
                        Margin="0,18,4,0" />

                <Button Content="🔥 Warm"
                        Command="{Binding WarmOllamaModelCommand}"
                        Margin="0,18,0,0" />

            </WrapPanel>
        </Border>

        <!-- ===== Status Bar ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                Padding="8,2">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding OllamaStatusText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ScanProgress.CurrentPath}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.8" />
            </StackPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid ColumnDefinitions="260,4,*" Background="#1E1E1E">

            <!-- Left: Folder Tree -->
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Folder Tree"
                               FontWeight="SemiBold"
                               Margin="8,6,8,4" />
                    <ScrollViewer>
                        <TreeView ItemsSource="{Binding FolderTree.Roots}"
                                  SelectedItem="{Binding FolderTree.SelectedItem, Mode=TwoWay}">
                            <!-- Bind IsExpanded/IsSelected on each container so lazy-load fires -->
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{ReflectionBinding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}"
                                                  x:DataType="vm:FolderTreeItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="📁" FontSize="12"/>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="#2D2D30" />

            <!-- Right: File Table + Detail panel -->
            <Grid Grid.Column="2"
                RowDefinitions="3*,4,2*"
                Background="#252526">

                <!-- File Table -->
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding FileTable.Rows}"
                          SelectedItem="{Binding FileTable.SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          MinHeight="180"
                          GridLinesVisibility="Horizontal"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Background="#1E1E1E"
                          Foreground="White"
                          RowBackground="#1E1E1E"
                          BorderBrush="#3E3E42"
                          BorderThickness="1"
                          HeadersVisibility="All">
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Background" Value="#1E1E1E" />
                        </Style>
                        <Style Selector="DataGridCell TextBlock">
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <Style Selector="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D30" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <!-- Remove default cell padding so color strip fills flush -->
                        <Style Selector="DataGridCell.color-strip">
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>

                        <!-- 4 px category color strip -->
                        <DataGridTemplateColumn Width="4" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Rectangle Fill="{Binding CategoryColor}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Dateiname"     Binding="{Binding Name}"        Width="2*"  IsReadOnly="True" />
                        <DataGridTextColumn Header="Typ"           Binding="{Binding Extension}"   Width="55"  IsReadOnly="True" />
                        <DataGridTextColumn Header="Größe"         Binding="{Binding SizeText}"    Width="85"  IsReadOnly="True" />
                        <DataGridTextColumn Header="Art"           Binding="{Binding FileType}"    Width="85"  IsReadOnly="True" />
                        <DataGridTextColumn Header="Konfidenz"     Binding="{Binding Confidence}"  Width="80"  IsReadOnly="True" />

                        <!-- Zusammenfassung -->
                        <DataGridTextColumn Header="Zusammenfassung" Binding="{Binding Summary}"  Width="3*"  IsReadOnly="True" />

                        <!-- Kategorie — inline ComboBox, auto-saves on change -->
                        <DataGridTemplateColumn Header="Kategorie" Width="155" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Border Background="{Binding CategoryColor}"
                                            CornerRadius="4"
                                            Padding="2,1"
                                            Margin="2,1">
                                        <ComboBox ItemsSource="{Binding AllCategories}"
                                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Background="Transparent"
                                                  Foreground="White"
                                                  BorderThickness="0"
                                                  Padding="4,1"
                                                  FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Zielordner — inline TextBox, saves on Enter -->
                        <DataGridTemplateColumn Header="Zielordner" Width="170" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Border Background="#2A2A2A"
                                            CornerRadius="4"
                                            Padding="2,1"
                                            Margin="2,1">
                                        <TextBox Text="{Binding EditTarget, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 Foreground="White"
                                                 BorderThickness="0"
                                                 Padding="4,1"
                                                 FontSize="11"
                                                 Watermark="Zielordner…">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Return" Command="{Binding CommitTargetCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Review — ○ / ✓ / ✎ toggle -->
                        <DataGridTemplateColumn Header="Review" Width="65" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Button Content="{Binding ReviewStatusDisplay}"
                                            Foreground="{Binding ReviewStatusColor}"
                                            Command="{Binding ToggleAcceptCommand}"
                                            ToolTip.Tip="{Binding ReviewStatusTooltip}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontWeight="Bold"
                                            FontSize="15"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="8,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1"
                              ResizeDirection="Rows"
                              Background="#2D2D30" />

                <!-- Detail Panel -->
                <Border Grid.Row="2"
                        Background="#252526"
                        BorderBrush="#3E3E42"
                        BorderThickness="1,1,0,0"
                        MinHeight="180">
                    <views:FileDetailView DataContext="{Binding FileDetail}" />
                </Border>

            </Grid>

        </Grid>

    </DockPanel>
</Window>
