<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartFileOrganizer.Desktop.ViewModels"
        xmlns:views="using:SmartFileOrganizer.Desktop.Views"
        x:Class="SmartFileOrganizer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Smart File Organizer"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#1E1E1E">

    <DockPanel Background="#1E1E1E">

        <!-- ===== Toolbar ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="📁 Choose Folder"
                        Command="{Binding PickFolderCommand}"
                        Margin="0,0,4,0" />

                <TextBlock Text="{Binding RootPath}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           MaxWidth="400"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                <Button Content="▶ Start Scan"
                        Command="{Binding StartScanCommand}"
                        Margin="0,0,4,0" />

                <Button Content="⏸ Pause"
                        Command="{Binding PauseScanCommand}"
                        IsEnabled="{Binding IsScanRunning}"
                        Margin="0,0,4,0" />

                <Button Content="⏹ Cancel"
                        Command="{Binding CancelScanCommand}"
                        IsEnabled="{Binding IsScanRunning}"
                        Margin="0,0,12,0" />

                <Button Content="▶ Resume Scan"
                    Command="{Binding ResumeScanCommand}"
                    Margin="0,0,4,0" />

                <Button Content="🏠 Home"
                    Command="{Binding BackToHomeCommand}"
                    Margin="0,0,4,0" />

                <Button Content="Plan"
                    ToolTip.Tip="Pläne der geöffneten Datenbank durchsehen, bestätigen und ausführen"
                    Command="{Binding OpenPlanCommand}"
                    CommandParameter="{x:Null}"
                    Margin="0,0,4,0" />

                <Button Content="CSV exportieren…"
                        Command="{Binding ExportCsvCommand}"
                        IsVisible="{Binding IsBrowserVisible}"
                        ToolTip.Tip="Alle Dateien des Jobs als CSV, wie sfo export"
                        Margin="0,0,12,0" />

                <!-- Progress -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScanProgress.StatusText}"
                               FontSize="11"
                               Margin="0,0,0,2"/>
                    <ProgressBar Value="{Binding ScanProgress.ProgressPercent}"
                                 Minimum="0" Maximum="100"
                                 Width="200" Height="6" />
                </StackPanel>

                <Separator Margin="12,0" Width="1" Height="28" />

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AiProgress.StatusText}"
                           FontSize="11"
                           Margin="0,0,0,2"/>
                    <ProgressBar Value="{Binding AiProgress.ProgressPercent}"
                         Minimum="0" Maximum="100"
                         Width="220" Height="6" />
                </StackPanel>

                <Button Content="▶ Resume AI"
                    Command="{Binding ResumeAiCommand}"
                    Margin="12,0,4,0" />

                <Button Content="⏸ Pause AI"
                    Command="{Binding PauseAiCommand}"
                    Margin="0,0,4,0" />

                <Button Content="⏹ Stop AI"
                    Command="{Binding CancelAiCommand}" />

                <Separator Margin="12,0" Width="1" Height="28" />

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Ollama URL" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding OllamaBaseUrl, Mode=TwoWay}"
                             Width="180"
                             Watermark="http://localhost:11434" />
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Vision model" FontSize="11" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding AvailableOllamaModels}"
                              SelectedItem="{Binding SelectedOllamaModel, Mode=TwoWay}"
                              Width="260">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OllamaModelViewModel">
                                <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Keep alive" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding OllamaKeepAlive, Mode=TwoWay}"
                             Width="90"
                             Watermark="60m" />
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Parallel req" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding OllamaParallelRequests, Mode=TwoWay}"
                             Width="70"
                             Watermark="1" />
                </StackPanel>

                <Button Content="🔄 Models"
                        Command="{Binding RefreshOllamaModelsCommand}"
                        Margin="0,18,4,0" />

                <Button Content="💾 Save AI"
                        Command="{Binding SaveOllamaSettingsCommand}"
                        Margin="0,18,4,0" />

                <Button Content="📝 Prompt…"
                        Command="{Binding OpenPromptSettingsCommand}"
                        Margin="0,18,4,0" />

                <Button Content="🔥 Warm"
                        Command="{Binding WarmOllamaModelCommand}"
                        Margin="0,18,0,0" />

            </WrapPanel>
        </Border>

        <!-- ===== Status Bar ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                Padding="8,2">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding DatabaseText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="SFO_DB setzt die Datenbank, wie in der CLI" />
                <TextBlock Text="{Binding OllamaStatusText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ExportStatusText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding ExportStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding ScanProgress.CurrentPath}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.8" />
            </StackPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Panel Background="#1E1E1E">

        <!-- Welcome / recent scans screen -->
        <Grid Background="#1E1E1E"
              IsVisible="{Binding IsWelcomeVisible}"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24"
                        MaxWidth="660">

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="Smart File Organizer"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="White" />
                    <TextBlock Text="Einen vorherigen Scan öffnen oder einen neuen starten."
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               Foreground="White" />
                </StackPanel>

                <Border Background="#252526"
                        CornerRadius="8"
                        Padding="0"
                        BorderBrush="#3E3E42"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Letzte Scans"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Padding="16,12,16,8"
                                   Foreground="White" />
                        <ListBox ItemsSource="{Binding RecentScans}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="340"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentScanItemViewModel">
                                    <Grid ColumnDefinitions="8,*,Auto"
                                          Margin="0,2"
                                          Background="#2D2D30">
                                        <!-- Status color strip -->
                                        <Rectangle Grid.Column="0"
                                                   Fill="{Binding StatusColor}"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch" />
                                        <!-- Info -->
                                        <StackPanel Grid.Column="1"
                                                    Spacing="2"
                                                    Margin="12,8">
                                            <TextBlock Text="{Binding RootPathDisplay}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{Binding FileCountDisplay}"
                                                           FontSize="11"
                                                           Opacity="0.7"
                                                           Foreground="White" />
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="11"
                                                           Foreground="{Binding StatusColor}" />
                                                <TextBlock Text="{Binding DateDisplay}"
                                                           FontSize="11"
                                                           Opacity="0.5"
                                                           Foreground="White" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Open / Delete buttons -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    Margin="8,0,12,0"
                                                    VerticalAlignment="Center">
                                            <Button Content="Öffnen"
                                                    Command="{Binding $parent[ListBox].DataContext.OpenRecentScanCommand}"
                                                    CommandParameter="{Binding Job}" />
                                            <Button Content="Plan"
                                                    ToolTip.Tip="Pläne dieses Jobs"
                                                    Command="{Binding $parent[ListBox].DataContext.OpenPlanCommand}"
                                                    CommandParameter="{Binding Job}" />
                                            <Button Content="🗑"
                                                    ToolTip.Tip="Scan restlos löschen"
                                                    Foreground="#FF5722"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="#FF5722"
                                                    Command="{Binding $parent[ListBox].DataContext.DeleteRecentScanCommand}"
                                                    CommandParameter="{Binding Job}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Button Content="📁  Neuen Scan starten…"
                        Command="{Binding PickFolderCommand}"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Padding="20,10" />

            </StackPanel>
        </Grid>

        <!-- Browser (tree + table + detail) -->
        <Grid ColumnDefinitions="300,4,*" Background="#1E1E1E"
              IsVisible="{Binding IsBrowserVisible}">

            <!-- Left: Folder Tree -->
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Folder Tree"
                               FontWeight="SemiBold"
                               Margin="8,6,8,4" />
                    <ScrollViewer>
                        <TreeView ItemsSource="{Binding FolderTree.Roots}"
                                  SelectedItem="{Binding FolderTree.SelectedItem, Mode=TwoWay}">
                            <!-- Bind IsExpanded/IsSelected on each container so lazy-load fires -->
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{ReflectionBinding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}"
                                                  x:DataType="vm:FolderTreeItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Im Explorer öffnen"
                                                          Command="{Binding RevealInExplorerCommand}" />
                                                <MenuItem Header="Diesen Ordner neu scannen &amp; bewerten"
                                                          Command="{Binding RescanDirectoryCommand}" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <TextBlock Text="📁" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <StackPanel Spacing="2" ToolTip.Tip="{Binding FactsToolTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasFacts}">
                                                <Border Background="{Binding VerdictColor}" CornerRadius="3" Padding="5,0"
                                                        IsVisible="{Binding HasVerdict}">
                                                    <TextBlock Text="{Binding VerdictLabel}" FontSize="10" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="✎" FontSize="10" Foreground="#E8A838" IsVisible="{Binding IsOverridden}"
                                                           ToolTip.Tip="Urteil von Hand gesetzt" />
                                                <Border BorderBrush="{Binding RetentionColor}" BorderThickness="1" CornerRadius="3" Padding="4,0"
                                                        IsVisible="{Binding HasRetention}">
                                                    <TextBlock Text="{Binding RetentionLabel}" FontSize="10" Foreground="#DDDDDD" />
                                                </Border>
                                                <Border Background="#B3261E" CornerRadius="3" Padding="4,0" IsVisible="{Binding HasSensitive}">
                                                    <TextBlock Text="{Binding SensitiveText}" FontSize="10" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="#2D2D30" />

            <!-- Right: File Table + Detail panel -->
            <Grid Grid.Column="2"
                RowDefinitions="Auto,Auto,Auto,3*,4,2*"
                Background="#252526">

                <!-- Folder banner: verdict, reason, purpose, own verdict (https://github.com/crack666/smart_file_organizer/issues/14) -->
                <Border Grid.Row="0"
                        Background="#1F2328"
                        BorderBrush="#3E3E42"
                        BorderThickness="0,0,0,1"
                        Padding="10,6"
                        IsVisible="{Binding Directory.IsVisible}">
                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="3">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Urteil ändern…"
                                        Command="{Binding Directory.ToggleEditCommand}"
                                        FontSize="11" Padding="8,2" VerticalAlignment="Center" />
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Directory.Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Border Background="{Binding Directory.VerdictColor}" CornerRadius="3" Padding="6,1" Margin="0,0,6,0"
                                            IsVisible="{Binding Directory.HasVerdict}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Directory.VerdictLabel}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding Directory.SourceText}" FontSize="11" Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Border BorderBrush="{Binding Directory.RetentionColor}" BorderThickness="1" CornerRadius="3" Padding="5,0" Margin="0,0,8,0"
                                            IsVisible="{Binding Directory.HasRetention}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Directory.RetentionLabel}" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Directory.SizeText}" FontSize="11" Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Border Background="#B3261E" CornerRadius="3" Padding="5,0" VerticalAlignment="Center"
                                            IsVisible="{Binding Directory.SensitiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding Directory.SensitiveText}" FontSize="11" Foreground="White" />
                                    </Border>
                                </WrapPanel>
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       IsVisible="{Binding Directory.Purpose, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Run Text="Zweck: " FontWeight="SemiBold" /><Run Text="{Binding Directory.Purpose}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       IsVisible="{Binding Directory.Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Run Text="Begründung: " FontWeight="SemiBold" /><Run Text="{Binding Directory.Reason}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Directory.EscalationText}" TextWrapping="Wrap" FontSize="12" Foreground="#E8A838"
                                       IsVisible="{Binding Directory.EscalationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Directory.OverrideText}" TextWrapping="Wrap" FontSize="11" Foreground="#E8A838"
                                       IsVisible="{Binding Directory.IsOverridden}" />
                            <TextBlock Text="{Binding Directory.ErrorText}" TextWrapping="Wrap" FontSize="11" Foreground="#FF7B72"
                                       IsVisible="{Binding Directory.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Directory.SkipText}" TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                                       IsVisible="{Binding Directory.SkipText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Directory.Summary}" TextWrapping="Wrap" FontSize="12" Foreground="#90C090"
                                       IsVisible="{Binding Directory.Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <!-- Own verdict -->
                            <Border IsVisible="{Binding Directory.IsEditing}" Background="#2A2D33" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                                <StackPanel Spacing="6">
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Urteil" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding Directory.VerdictOptions}"
                                                  SelectedItem="{Binding Directory.SelectedVerdict, Mode=TwoWay}"
                                                  Width="150" Margin="0,0,12,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VerdictOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Erhaltungswert" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:DirectoryBannerViewModel.RetentionOptions}"
                                                  SelectedItem="{Binding Directory.SelectedRetention, Mode=TwoWay}"
                                                  Width="130" Margin="0,0,12,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RetentionOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Text="{Binding Directory.Note, Mode=TwoWay}" Watermark="Warum? (optional)" Width="260" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Directory.EffectText}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Speichern" Command="{Binding Directory.SaveOverrideCommand}" />
                                        <Button Content="Eigenes Urteil zurücknehmen" Command="{Binding Directory.ResetOverrideCommand}"
                                                ToolTip.Tip="Das Urteil von Regel oder Modell gilt wieder" />
                                        <Button Content="Abbrechen" Command="{Binding Directory.ToggleEditCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Directory.EditStatus}" TextWrapping="Wrap" FontSize="11" Foreground="#E8A838"
                                       IsVisible="{Binding Directory.EditStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Filters -->
                <Border Grid.Row="1" Background="#252526" Padding="8,4" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                    <WrapPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{x:Static vm:FileTableViewModel.CategoryFilters}"
                                  SelectedItem="{Binding FileTable.SelectedCategoryFilter, Mode=TwoWay}"
                                  Width="170" Margin="0,0,6,0" FontSize="12">
                        </ComboBox>
                        <ComboBox ItemsSource="{x:Static vm:FileTableViewModel.StatusFilters}"
                                  SelectedItem="{Binding FileTable.SelectedStatusFilter, Mode=TwoWay}"
                                  Width="170" Margin="0,0,10,0" FontSize="12">
                        </ComboBox>
                        <CheckBox Content="niedrige Konfidenz" IsChecked="{Binding FileTable.OnlyLowConfidence, Mode=TwoWay}"
                                  ToolTip.Tip="{Binding FileTable.LowConfidenceHint}" Margin="0,0,10,0" FontSize="12" />
                        <CheckBox Content="sensibel" IsChecked="{Binding FileTable.OnlySensitive, Mode=TwoWay}" Margin="0,0,10,0" FontSize="12" />
                        <CheckBox Content="temporär" IsChecked="{Binding FileTable.OnlyTemporary, Mode=TwoWay}"
                                  ToolTip.Tip="Vom Modell als vorübergehend eingestuft: Installer, Download-Rest, Doppel" Margin="0,0,10,0" FontSize="12" />
                        <Button Content="Filter aus" Command="{Binding FileTable.ResetFiltersCommand}" IsVisible="{Binding FileTable.IsFiltered}"
                                FontSize="11" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileTable.CountText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                    </WrapPanel>
                </Border>

                <!-- Common correction of the checked files -->
                <Border Grid.Row="2" Background="#2A2D33" Padding="8,4">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Alle sichtbaren auswählen" Command="{Binding FileTable.CheckAllShownCommand}"
                                FontSize="11" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Button Content="Auswahl aufheben" Command="{Binding FileTable.ClearChecksCommand}" IsVisible="{Binding FileTable.HasChecked}"
                                FontSize="11" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileTable.CheckedText}" IsVisible="{Binding FileTable.HasChecked}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{x:Static vm:FileTableViewModel.AllCategories}"
                                  SelectedItem="{Binding FileTable.BulkCategory, Mode=TwoWay}"
                                  PlaceholderText="Kategorie…"
                                  IsVisible="{Binding FileTable.HasChecked}"
                                  Width="160" Margin="0,0,6,0" FontSize="12" />
                        <Button Content="Kategorie setzen" Command="{Binding FileTable.ApplyCategoryToCheckedCommand}"
                                IsVisible="{Binding FileTable.HasChecked}" FontSize="11" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileTable.BulkStatus}" FontSize="11" Foreground="#E8A838" VerticalAlignment="Center" TextWrapping="Wrap"
                                   IsVisible="{Binding FileTable.BulkStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </WrapPanel>
                </Border>

                <!-- File Table -->
                <TextBlock Grid.Row="3" Text="{Binding FileTable.EmptyText}" Opacity="0.6" Margin="12,40,12,0"
                           HorizontalAlignment="Center" ZIndex="1" IsHitTestVisible="False"
                           IsVisible="{Binding FileTable.EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding FileTable.Rows}"
                          SelectedItem="{Binding FileTable.SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          MinHeight="180"
                          GridLinesVisibility="Horizontal"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Background="#1E1E1E"
                          Foreground="White"
                          RowBackground="#1E1E1E"
                          BorderBrush="#3E3E42"
                          BorderThickness="1"
                          HeadersVisibility="Column">
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Background" Value="#1E1E1E" />
                        </Style>
                        <Style Selector="DataGridCell TextBlock">
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <Style Selector="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D30" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <!-- Remove default cell padding so color strip fills flush -->
                        <Style Selector="DataGridCell.color-strip">
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>

                        <!-- 4 px category color strip -->
                        <DataGridTemplateColumn Width="4" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Rectangle Fill="{Binding CategoryColor}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="34" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" MinWidth="0"
                                              ToolTip.Tip="Für die Sammelkorrektur auswählen" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Dateiname" Width="2*" IsReadOnly="True" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <DockPanel Margin="4,0">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Datei neu analysieren"
                                                          Command="{Binding ReanalyzeCommand}" />
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <Border DockPanel.Dock="Right" Background="#B3261E" CornerRadius="3" Padding="4,0" Margin="4,0,0,0"
                                                VerticalAlignment="Center" IsVisible="{Binding IsSensitive}"
                                                ToolTip.Tip="Sensible Datei: Vorschau erst nach Klick">
                                            <TextBlock Text="{Binding SensitiveText}" FontSize="10" Foreground="White" />
                                        </Border>
                                        <Border DockPanel.Dock="Right" Background="#6B5B1E" CornerRadius="3" Padding="4,0" Margin="4,0,0,0"
                                                VerticalAlignment="Center" IsVisible="{Binding IsTemporary}"
                                                ToolTip.Tip="Vom Modell als vorübergehend eingestuft">
                                            <TextBlock Text="temporär" FontSize="10" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Zustand"       Binding="{Binding StatusText}"  Width="92"  IsReadOnly="True" />
                        <DataGridTextColumn Header="Größe"         Binding="{Binding SizeText}"    Width="80"  IsReadOnly="True" />
                        <DataGridTextColumn Header="Konfidenz"     Binding="{Binding Confidence}"  Width="92"  IsReadOnly="True" />

                        <!-- Zusammenfassung -->
                        <DataGridTextColumn Header="Zusammenfassung" Binding="{Binding Summary}"  Width="2*"  IsReadOnly="True" />

                        <!-- Kategorie — inline ComboBox, auto-saves on change -->
                        <DataGridTemplateColumn Header="Kategorie" Width="140" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Border Background="{Binding CategoryColor}"
                                            CornerRadius="4"
                                            Padding="2,1"
                                            Margin="2,1">
                                        <ComboBox ItemsSource="{Binding AllCategories}"
                                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Background="Transparent"
                                                  Foreground="White"
                                                  BorderThickness="0"
                                                  Padding="4,1"
                                                  FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Zielordner — inline TextBox, saves on Enter -->
                        <DataGridTemplateColumn Header="Zielordner" Width="100" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Border Background="#2A2A2A"
                                            CornerRadius="4"
                                            Padding="2,1"
                                            Margin="2,1">
                                        <TextBox Text="{Binding EditTarget, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 Foreground="White"
                                                 BorderThickness="0"
                                                 Padding="4,1"
                                                 FontSize="11"
                                                 Watermark="Zielordner…">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Return" Command="{Binding CommitTargetCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Review — ○ / ✓ / ✎ toggle -->
                        <DataGridTemplateColumn Header="Review" Width="55" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Button Content="{Binding ReviewStatusDisplay}"
                                            Foreground="{Binding ReviewStatusColor}"
                                            Command="{Binding ToggleAcceptCommand}"
                                            ToolTip.Tip="{Binding ReviewStatusTooltip}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontWeight="Bold"
                                            FontSize="15"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="8,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="4"
                              ResizeDirection="Rows"
                              Background="#2D2D30" />

                <!-- Detail Panel -->
                <Border Grid.Row="5"
                        Background="#252526"
                        BorderBrush="#3E3E42"
                        BorderThickness="1,1,0,0"
                        MinHeight="180">
                    <views:FileDetailView DataContext="{Binding FileDetail}" />
                </Border>

            </Grid>

        </Grid>

        <!-- Plan: review, confirm, execute (https://github.com/crack666/smart_file_organizer/issues/15) -->
        <Border IsVisible="{Binding IsShowingPlan}" Background="#1E1E1E">
            <views:PlanView DataContext="{Binding Plan}" />
        </Border>

        </Panel>

    </DockPanel>
</Window>
