<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartFileOrganizer.Cli\SmartFileOrganizer.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same Ollama stand-in as the hosting tests; never touches the network. -->
    <Compile Include="..\SmartFileOrganizer.Hosting.Tests\FakeOllamaService.cs" Link="FakeOllamaService.cs" />
    <!-- Links and unreadable folders in temp folders, removed as links; shared with the application tests. -->
    <Compile Include="..\SmartFileOrganizer.Application.Tests\FileSystemLinks.cs" Link="FileSystemLinks.cs" />
  </ItemGroup>

</Project>
